# Copie para .env.local para sobrescrever localmente.
# Variáveis definidas no provedor de hospedagem têm prioridade sobre os arquivos .env.

# Origem do catálogo: "mock" (dados locais em lib/catalog/mock-data.ts) ou "api" (fantasiando-backend).
CATALOG_SOURCE=mock

# URL base da API pública (obrigatória quando CATALOG_SOURCE=api). Sem barra no final.
CATALOG_API_URL=http://localhost:3333/api/v1

# Número do WhatsApp do ateliê, só dígitos com DDI e DDD (ex.: 5524999999999).
NEXT_PUBLIC_WHATSAPP_NUMBER=5524999999999

# URL pública do site, usada nos links enviados pelo WhatsApp.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
